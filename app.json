{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.aqara.cameras",
  "sdk": 3,
  "version": "1.1.0",
  "compatibility": ">=8.0.0",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Aqara Cameras",
    "nl": "Aqara Camera's"
  },
  "description": {
    "en": "Aqara camera integration with OAuth2 discovery, local RTSP streaming and multi-camera support.",
    "nl": "Aqara camera-integratie met OAuth2-discovery, lokale RTSP-streaming en ondersteuning voor meerdere camera's."
  },
  "category": "security",
  "brandColor": "#2F6BFF",
  "author": {
    "name": "Jules",
    "email": "jules@example.com"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "api": {
    "configure": {
      "method": "POST",
      "path": "/configure"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "motion_detected",
        "title": {
          "en": "Motion detected"
        },
        "tokens": [
          {
            "name": "snapshot",
            "type": "image",
            "title": {
              "en": "Snapshot"
            }
          }
        ]
      },
      {
        "id": "person_detected",
        "title": {
          "en": "Person detected"
        }
      },
      {
        "id": "sound_detected",
        "title": {
          "en": "Sound detected"
        },
        "tokens": [
          {
            "name": "decibel",
            "type": "number",
            "title": {
              "en": "Sound level"
            },
            "units": {
              "en": "dB"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "export_recording",
        "title": {
          "en": "Export the latest recording"
        },
        "tokens": [
          {
            "name": "recording_url",
            "type": "string",
            "title": {
              "en": "Recording URL"
            }
          }
        ]
      },
      {
        "id": "play_audio_clip",
        "title": {
          "en": "Play audio clip [[clip]]"
        },
        "titleFormatted": {
          "en": "Play audio clip [[clip]]"
        },
        "args": [
          {
            "name": "clip",
            "type": "text",
            "title": {
              "en": "Audio clip"
            }
          }
        ]
      },
      {
        "title": {
          "en": "Set privacy mode to [[enabled]]",
          "nl": "Stel privacymodus in op [[enabled]]"
        },
        "titleFormatted": {
          "en": "Set privacy mode to [[enabled]]",
          "nl": "Stel privacymodus in op [[enabled]]"
        },
        "args": [
          {
            "name": "enabled",
            "type": "dropdown",
            "title": {
              "en": "Enabled",
              "nl": "Ingeschakeld"
            },
            "values": [
              {
                "id": "true",
                "title": {
                  "en": "Enabled",
                  "nl": "Ingeschakeld"
                }
              },
              {
                "id": "false",
                "title": {
                  "en": "Disabled",
                  "nl": "Uitgeschakeld"
                }
              }
            ]
          }
        ],
        "id": "set_privacy_mode"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Aqara Camera",
        "nl": "Aqara Camera"
      },
      "class": "camera",
      "images": {
        "small": "/drivers/camera/assets/images/small.png",
        "large": "/drivers/camera/assets/images/large.png",
        "xlarge": "/drivers/camera/assets/images/xlarge.png"
      },
      "capabilities": [
        "onoff",
        "light_mode",
        "speaker_playing",
        "microphone"
      ],
      "capabilitiesOptions": {
        "onoff": {
          "title": {
            "en": "Camera Status / Privacy",
            "nl": "Camera status / privacy"
          }
        }
      },
      "views": [
        {
          "id": "camera_view",
          "title": {
            "en": "Live Feed & Intercom",
            "nl": "Live feed & Intercom"
          }
        }
      ],
      "pair": [
        {
          "id": "login_oauth2",
          "template": "login_oauth2",
          "options": {
            "title": {
              "en": "Connect Aqara",
              "nl": "Aqara koppelen"
            },
            "hint": {
              "en": "Sign in with your Aqara account",
              "nl": "Log in met je Aqara-account"
            },
            "button": {
              "en": "Log in with Aqara",
              "nl": "Inloggen met Aqara"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_oauth2",
          "template": "login_oauth2",
          "options": {
            "title": {
              "en": "Reconnect Aqara",
              "nl": "Aqara opnieuw koppelen"
            },
            "hint": {
              "en": "Your Aqara authorization needs attention",
              "nl": "Je Aqara-autorisatie moet opnieuw worden gekoppeld"
            },
            "button": {
              "en": "Log in with Aqara",
              "nl": "Inloggen met Aqara"
            }
          }
        }
      ],
      "id": "camera",
      "settings": [
        {
          "id": "camera_name",
          "type": "text",
          "label": {
            "en": "Camera name",
            "nl": "Cameranaam"
          },
          "value": "Aqara Camera"
        },
        {
          "id": "rtsp_url",
          "type": "text",
          "label": {
            "en": "Local RTSP URL",
            "nl": "Lokale RTSP-URL"
          },
          "hint": {
            "en": "Optional. Example: rtsp://user:password@192.168.1.10:8554/ch1",
            "nl": "Optioneel. Bijvoorbeeld: rtsp://user:wachtwoord@192.168.1.10:8554/ch1"
          },
          "optional": true
        }
      ]
    }
  ],
  "capabilities": {
    "light_mode": {
      "type": "enum",
      "title": {
        "en": "Light mode"
      },
      "getable": true,
      "setable": true,
      "values": [
        {
          "id": "IR-nightvision",
          "title": {
            "en": "IR night vision"
          }
        },
        {
          "id": "Auto",
          "title": {
            "en": "Auto"
          }
        },
        {
          "id": "Off",
          "title": {
            "en": "Off"
          }
        }
      ]
    },
    "microphone": {
      "type": "boolean",
      "title": {
        "en": "Microphone enabled"
      },
      "getable": true,
      "setable": true,
      "decimals": 0
    },
    "speaker_playing": {
      "type": "boolean",
      "title": {
        "en": "Speaker playing"
      },
      "getable": true,
      "setable": false,
      "decimals": 0
    }
  }
}