{
  "id": "com.aqara.cameras",
  "sdk": 3,
  "version": "1.2.0",
  "compatibility": ">=8.0.0",
  "platforms": ["local"],
  "name": {
    "en": "Aqara Cameras",
    "nl": "Aqara Camera's"
  },
  "description": {
    "en": "Aqara camera integration with account authorization, OAuth2 discovery, local RTSP streaming and multi-camera support.",
    "nl": "Aqara camera-integratie met accountautorisatie, OAuth2-discovery, lokale RTSP-streaming en ondersteuning voor meerdere camera's."
  },
  "category": "security",
  "brandColor": "#2F6BFF",
  "author": {
    "name": "Jules",
    "email": "jules@example.com"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "api": {
    "configure": {
      "method": "POST",
      "path": "/configure"
    },
    "authCode": {
      "method": "POST",
      "path": "/auth-code"
    },
    "verifyAuthCode": {
      "method": "POST",
      "path": "/verify-auth-code"
    },
    "status": {
      "method": "GET",
      "path": "/status"
    },
    "disconnect": {
      "method": "POST",
      "path": "/disconnect"
    }
  }
}
